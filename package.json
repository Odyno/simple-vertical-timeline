{
  "name": "simple-vertical-timeline",
  "version": "0.2.0",
  "description": "Simple Vertical Timeline is a simple plugin that allow you to create a timeline in your Article or Page.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Odyno/simple-vertical-timeline.git"
  },
  "scripts": {
    "build": "npm run build:css && wp-scripts build --webpack-src-dir=blocks/src --output-path=blocks/build",
    "build:css": "npm run build:css:frontend && npm run build:css:admin",
    "build:css:frontend": "cleancss -O2 -o css/simple-vertical-timeline.min.css css/simple-vertical-timeline.css",
    "build:css:admin": "cleancss -O2 -o admin/css/admin-style.min.css admin/css/admin-style.css",
    "start": "wp-scripts start --webpack-src-dir=blocks/src --output-path=blocks/build",
    "lint:js": "wp-scripts lint-js blocks/src",
    "format": "wp-scripts format blocks/src"
  },
  "keywords": [
    "simple",
    "vertical",
    "timeline",
    "block"
  ],
  "author": "Odyno (alessandro@staniscia.net)",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/Odyno/simple-vertical-timeline/issues"
  },
  "homepage": "https://github.com/Odyno/simple-vertical-timeline#readme",
  "devDependencies": {
    "@wordpress/scripts": "^27.0.0",
    "clean-css-cli": "^5.6.3"
  }
}
